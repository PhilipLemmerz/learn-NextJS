{
  "pages": {
    "/(LandingPages)/page": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/(LandingPages)/page.js"
    ],
    "/(LandingPages)/layout": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/css/app/(LandingPages)/layout.css",
      "static/chunks/app/(LandingPages)/layout.js"
    ],
    "/(Website)/news/page": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/(Website)/news/page.js"
    ],
    "/(Website)/layout": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/css/app/(Website)/layout.css",
      "static/chunks/app/(Website)/layout.js"
    ],
    "/(Website)/archive/layout": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/(Website)/archive/layout.js"
    ],
    "/(Website)/archive/@archive/[[...filter]]/page": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/(Website)/archive/@archive/[[...filter]]/page.js"
    ],
    "/(Website)/archive/@latest/default": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/(Website)/archive/@latest/default.js"
    ],
    "/(Website)/news/[news]/page": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/(Website)/news/[news]/page.js"
    ],
    "/(Website)/news/[news]/layout": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/(Website)/news/[news]/layout.js"
    ],
    "/(Website)/news/[news]/@modal/default": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/(Website)/news/[news]/@modal/default.js"
    ]
  }
}